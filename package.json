{
  "name": "legal-design-storybook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.app.json",
    "check:tokens": "node scripts/check-tokens.mjs",
    "build:storybook": "storybook build -o dist/storybook",
    "build:sistema": "vite build --config vite.sistema.config.ts",
    "build:pages": "npm run build:storybook && npm run build:sistema && node -e \"require(\\\"fs\\\").copyFileSync(\\\"pages-raiz/index.html\\\",\\\"dist/index.html\\\")\"",
    "sistema": "vite --config vite.sistema.config.ts --port 6010"
  },
  "dependencies": {
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-interactions": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "storybook": "^8.6.12",
    "typescript": "~5.6.2",
    "vite": "^6.2.0"
  }
}
